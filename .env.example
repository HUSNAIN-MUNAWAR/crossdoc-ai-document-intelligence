APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./crossdoc_local.sqlite3
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_DIR=.storage
CROSSDOC_DEMO_OCR=false
CROSSDOC_DEMO_MODE=false
ENABLE_PADDLEOCR=true
ENABLE_TESSERACT=true
ENABLE_DOCLING=true
ENABLE_LAYOUTPARSER=true
OCR_LANG=en
OCR_CONFIDENCE_THRESHOLD=0.72
REVIEW_CONFIDENCE_THRESHOLD=0.75
LAYOUT_MODE=heuristic
